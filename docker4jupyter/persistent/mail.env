# Gaia MagicDuck:
# Configuration variables to be used within the container,
# mainly for the automatic sending of mails.

# Persistent directory, default /var/lib/jupyterhub
HUB_STATE_DIR=/var/lib/jupyterhub
# First UID handed out to new users, default 10000
UID_MIN=10000

# URL shown in the approval mail, e.g. https://example.org/my_public_url_path/
HUB_PUBLIC_URL="Test hub"

# Mail server (if unset, mails are skipped with a warning)
SMTP_HOST=
# Mail port, default 587 (STARTTLS); 465 uses implicit SSL
SMTP_PORT=
# Optional login
SMTP_USER=
SMTP_PASSWORD=
# Sender; default is SMTP_USER
MAIL_FROM=
# Address where signup notifications go
ADMIN_EMAIL=
